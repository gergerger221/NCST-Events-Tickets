{
  "name": "integ-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --https",
    "build": "tsc -b && vite build",
    "deploy:xampp": "npm run build && powershell -Command \"Copy-Item -Path 'dist/*' -Destination 'C:/xampp/htdocs/Integ 2' -Recurse -Force; Copy-Item -Path 'api/*' -Destination 'C:/xampp/htdocs/Integ 2/api' -Recurse -Force; Copy-Item -Path '.htaccess' -Destination 'C:/xampp/htdocs/Integ 2/.htaccess' -Force; Write-Host 'XAMPP deployment build assets successfully deployed.'\"",
    "test": "node scripts/run-all-tests.mjs && php scripts/run-all-tests.php",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "lucide-vue-next": "^1.0.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.43",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
