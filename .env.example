# NCST Events & Attendance Ticketing System - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Environment Mode: 'development' (default XAMPP setup) or 'production' (hardened)
APP_ENV=development

# Application Secret for HMAC-SHA256 Token Signatures (Generate a 64+ char random string in production)
# CRITICAL: In production (APP_ENV=production), the API strictly refuses to start if APP_SECRET is missing or default!
# APP_KEY is supported as an alias for compatibility with deployment scripts.
APP_SECRET=your_secure_random_64_character_hmac_secret_key_here
APP_KEY=your_secure_random_64_character_hmac_secret_key_here

# Allowed CORS Origins (comma-separated)
APP_ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost,http://127.0.0.1:5173,https://127.0.0.1:5173,https://192.168.254.104:5173,http://192.168.254.104:5173

# Controlled Defense / Evaluation Demo Mode
# In production builds, demo account auto-fill is always permanently disabled.
# Set to 'true' only to enable demo account helper buttons during local development evaluation/defense.
VITE_ENABLE_DEMO_ACCOUNTS=false

# ==============================================================================
# Database Configuration
# ==============================================================================
# Development (Default XAMPP):
#   DB_USER=root
#   DB_PASS=
#
# Production Security Recommendation:
#   Create a dedicated least-privilege database user without GRANT or DROP rights:
#
#   CREATE USER 'ncst_app_user'@'localhost' IDENTIFIED BY 'StrongPasswordHere!';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `event_attendance_db`.* TO 'ncst_app_user'@'localhost';
#   FLUSH PRIVILEGES;
#
# Then configure below:
#   DB_USER=ncst_app_user
#   DB_PASS=StrongPasswordHere!
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_attendance_db
DB_USER=root
DB_PASS=

# ==============================================================================
# SMTP Email Dispatcher Configuration
# ==============================================================================
# Driver: 'smtp' (live email delivery via PHPMailer / sockets) or 'mock' (simulated)
MAIL_DRIVER=smtp

# SMTP Server Host (e.g. smtp.gmail.com, smtp.office365.com, sandbox.smtp.mailtrap.io)
# Note: Leaving SMTP_HOST empty in development automatically enables simulated mock mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls

# SMTP Authentication Credentials
# For Gmail: Use a 16-character Google App Password (not your personal password).
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Sender Details
SMTP_FROM_ADDRESS=no-reply@student.ncst.edu.ph
SMTP_FROM_NAME="NCST Student Portal"
SMTP_REPLY_TO=support@ncst.edu.ph
